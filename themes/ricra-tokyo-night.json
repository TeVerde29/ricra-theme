    "editorGutter.deletedBackground": "#F7768E",
    "editorOverviewRuler.border": "#1A1B26",
    "editorWidget.background": "#1F2335",
    "editorWidget.border": "#414868",
    "editorSuggestWidget.background": "#1F2335",
    "editorSuggestWidget.border": "#414868",
    "editorSuggestWidget.selectedBackground": "#414868",
    "editorHoverWidget.background": "#1F2335",
    "editorHoverWidget.border": "#414868",
    "editorError.foreground": "#F7768E",
    "editorWarning.foreground": "#E0AF68",
    "editorInfo.foreground": "#7AA2F7",

    "sideBar.background": "#1A1B26",
    "sideBar.foreground": "#A9B1D6",
    "sideBar.border": "#1A1B26",
