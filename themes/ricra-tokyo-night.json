    "input.background": "#1F2335",
    "input.foreground": "#A9B1D6",
    "input.border": "#414868",
    "input.placeholderForeground": "#565F89",
    "inputOption.activeBorder": "#BB9AF7",

    "dropdown.background": "#1F2335",
    "dropdown.foreground": "#A9B1D6",
    "dropdown.border": "#414868",

    "list.activeSelectionBackground": "#414868",
    "list.activeSelectionForeground": "#A9B1D6",
    "list.inactiveSelectionBackground": "#1A1B26",
    "list.hoverBackground": "#414868",
    "list.highlightForeground": "#BB9AF7",

    "panel.background": "#1A1B26",
    "panel.border": "#1A1B26",
    "panelTitle.activeForeground": "#A9B1D6",
    "panelTitle.inactiveForeground": "#565F89",
    "panelTitle.activeBorder": "#1A1B26",

    "terminal.background": "#1A1B26",
    "terminal.foreground": "#A9B1D6",
    "terminal.ansiBlack": "#1A1B26",
    "terminal.ansiRed": "#F7768E",
    "terminal.ansiGreen": "#9ECE6A",
    "terminal.ansiYellow": "#E0AF68",
    "terminal.ansiBlue": "#7AA2F7",
    "terminal.ansiMagenta": "#BB9AF7",
    "terminal.ansiCyan": "#73DACA",
    "terminal.ansiWhite": "#A9B1D6",
    "terminal.ansiBrightBlack": "#565F89",
    "terminal.ansiBrightRed": "#F7768E",
    "terminal.ansiBrightGreen": "#9ECE6A",
    "terminal.ansiBrightYellow": "#E0AF68",
    "terminal.ansiBrightBlue": "#7AA2F7",
    "terminal.ansiBrightMagenta": "#BB9AF7",
    "terminal.ansiBrightCyan": "#73DACA",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.addedResourceForeground": "#9ECE6A",
    "gitDecoration.modifiedResourceForeground": "#7AA2F7",
    "gitDecoration.deletedResourceForeground": "#F7768E",
    "gitDecoration.untrackedResourceForeground": "#BB9AF7"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#565F89",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#A9B1D6"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#1A1B26",
        "background": "#F7768E"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#9ECE6A",
    "type": "#9ECE6A",
    "class": "#9ECE6A",
    "enum": "#9ECE6A",
    "interface": "#9ECE6A",
    "struct": "#9ECE6A",
    "typeParameter": "#9ECE6A",
    "parameter": "#E0AF68",
    "variable": "#E0AF68",
    "property": "#A9B1D6",
    "enumMember": "#E0AF68",
    "event": "#7AA2F7",
    "function": "#7AA2F7",
    "method": "#7AA2F7",
    "macro": "#BB9AF7",
    "keyword": "#BB9AF7",
    "modifier": "#BB9AF7",
    "comment": "#565F89",
    "string": "#73DACA",
    "number": "#E0AF68",
    "regexp": "#F7768E",
    "operator": "#73DACA"
  }
}
