    "gitDecoration.untrackedResourceForeground": "#5A9CB5"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#AFC49A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#AFC49A"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#C49A3A"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#C2D7A3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#DDE8C8"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#5A9CB5"
      }
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#F1F5EB"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#C2D7A3"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#D96B67"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#C49A3A"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#111A13",
        "background": "#D96B67"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#5A9CB5",
    "type": "#5A9CB5",
    "class": "#5A9CB5",
    "enum": "#5A9CB5",
    "interface": "#5A9CB5",
    "struct": "#5A9CB5",
    "typeParameter": "#5A9CB5",
    "parameter": "#F1F5EB",
    "variable": "#F1F5EB",
    "property": "#B5C0B2",
    "enumMember": "#C49A3A",
    "event": "#DDE8C8",
    "function": "#DDE8C8",
    "method": "#DDE8C8",
    "macro": "#C2D7A3",
    "keyword": "#C2D7A3",
    "modifier": "#C2D7A3",
    "comment": "#829B78",
    "string": "#AFC49A",
    "number": "#C49A3A",
    "regexp": "#D96B67",
    "operator": "#B5C0B2"
  }
}