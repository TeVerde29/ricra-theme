    "editor.findMatchHighlightBackground": "#EEF2E8",
    "editor.lineHighlightBackground": "#F7F8F1",
    "editor.lineHighlightBorder": "#EEF2E8",
    "editorWhitespace.foreground": "#D9E2D5",
    "editorIndentGuide.background": "#D9E2D5",
