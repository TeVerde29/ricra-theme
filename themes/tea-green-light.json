    "button.secondaryBackground": "#DDE8C8",
    "button.secondaryForeground": "#1E2A21",
    "button.secondaryHoverBackground": "#AFC49A",

    "input.background": "#FFFFFF",
    "input.foreground": "#1E2A21",
    "input.border": "#D9E2D5",
    "input.placeholderForeground": "#5E6E5F",
    "inputOption.activeBorder": "#567B3B",

    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#1E2A21",
    "dropdown.border": "#D9E2D5",

    "list.activeSelectionBackground": "#DDE8C8",
    "list.activeSelectionForeground": "#1E2A21",
    "list.inactiveSelectionBackground": "#EEF2E8",
    "list.hoverBackground": "#F7F8F1",
    "list.highlightForeground": "#294635",

    "panel.background": "#F7F8F1",
    "panel.border": "#D9E2D5",
    "panelTitle.activeForeground": "#1E2A21",
    "panelTitle.inactiveForeground": "#5E6E5F",
    "panelTitle.activeBorder": "#AFC49A",

    "terminal.background": "#F7F8F1",
    "terminal.foreground": "#1E2A21",
    "terminal.ansiBlack": "#1E2A21",
    "terminal.ansiRed": "#B44743",
    "terminal.ansiGreen": "#337652",
    "terminal.ansiYellow": "#976719",
    "terminal.ansiBlue": "#3F7082",
    "terminal.ansiMagenta": "#567B3B",
    "terminal.ansiCyan": "#4F7256",
    "terminal.ansiWhite": "#F7F8F1",
    "terminal.ansiBrightBlack": "#5E6E5F",
    "terminal.ansiBrightRed": "#D96B67",
    "terminal.ansiBrightGreen": "#4F7256",
    "terminal.ansiBrightYellow": "#C49A3A",
    "terminal.ansiBrightBlue": "#5A9CB5",
    "terminal.ansiBrightMagenta": "#AFC49A",
    "terminal.ansiBrightCyan": "#567B3B",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.addedResourceForeground": "#337652",
    "gitDecoration.modifiedResourceForeground": "#976719",
    "gitDecoration.deletedResourceForeground": "#B44743",
    "gitDecoration.untrackedResourceForeground": "#3F7082"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#567B3B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#4F7256"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#976719"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#294635",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#567B3B"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#3F7082"
      }
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#1E2A21"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#5E6E5F"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#B44743"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#976719"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F7F8F1",
        "background": "#B44743"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#3F7082",
    "type": "#3F7082",
    "class": "#3F7082",
    "enum": "#3F7082",
    "interface": "#3F7082",
    "struct": "#3F7082",
    "typeParameter": "#3F7082",
    "parameter": "#1E2A21",
    "variable": "#1E2A21",
    "property": "#5E6E5F",
    "enumMember": "#976719",
    "event": "#567B3B",
    "function": "#567B3B",
    "method": "#567B3B",
    "macro": "#294635",
    "keyword": "#294635",
    "modifier": "#294635",
    "comment": "#567B3B",
    "string": "#4F7256",
    "number": "#976719",
    "regexp": "#B44743",
    "operator": "#5E6E5F"
  }
}