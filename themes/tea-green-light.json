    "editorGutter.deletedBackground": "#B44743",
    "editorOverviewRuler.border": "#D9E2D5",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#D9E2D5",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.border": "#D9E2D5",
    "editorSuggestWidget.selectedBackground": "#DDE8C8",
    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.border": "#D9E2D5",
    "editorError.foreground": "#B44743",
    "editorWarning.foreground": "#976719",
    "editorInfo.foreground": "#3F7082",

    "sideBar.background": "#EEF2E8",
    "sideBar.foreground": "#1E2A21",
    "sideBar.border": "#D9E2D5",
    "sideBarTitle.foreground": "#294635",
    "sideBarSectionHeader.background": "#F7F8F1",
    "sideBarSectionHeader.foreground": "#294635",
    "sideBarSectionHeader.border": "#D9E2D5",

    "activityBar.background": "#294635",
    "activityBar.foreground": "#F7F8F1",
    "activityBar.inactiveForeground": "#AFC49A",
    "activityBar.border": "#1E2A21",
    "activityBarBadge.background": "#AFC49A",
    "activityBarBadge.foreground": "#1E2A21",

    "statusBar.background": "#294635",
    "statusBar.foreground": "#F7F8F1",
    "statusBar.border": "#1E2A21",
    "statusBarItem.hoverBackground": "#4F7256",
    "statusBarItem.remoteBackground": "#AFC49A",
    "statusBarItem.remoteForeground": "#1E2A21",

    "titleBar.activeBackground": "#F7F8F1",
    "titleBar.activeForeground": "#1E2A21",
    "titleBar.inactiveBackground": "#EEF2E8",
    "titleBar.inactiveForeground": "#5E6E5F",
    "titleBar.border": "#D9E2D5",

    "tab.activeBackground": "#F7F8F1",
    "tab.activeForeground": "#1E2A21",
    "tab.inactiveBackground": "#EEF2E8",
    "tab.inactiveForeground": "#5E6E5F",
    "tab.border": "#D9E2D5",
    "tab.activeBorder": "#AFC49A",
    "tab.unfocusedActiveBorder": "#DDE8C8",

    "button.background": "#294635",
    "button.foreground": "#F7F8F1",
