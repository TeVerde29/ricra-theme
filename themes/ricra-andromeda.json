    "gitDecoration.addedResourceForeground": "#9BC53D",
    "gitDecoration.modifiedResourceForeground": "#5BC0EB",
    "gitDecoration.deletedResourceForeground": "#FC644D",
    "gitDecoration.untrackedResourceForeground": "#00B0FF"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#A0A1A7CC"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#96E072"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#F39C12"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#C74DED"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#FFE66D"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#FFE66D"
      }
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#00E8C6"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#00E8C6"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#FFE66D"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#23262E",
        "background": "#FC644D"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#FFE66D",
    "type": "#FFE66D",
    "class": "#FFE66D",
    "enum": "#FFE66D",
    "interface": "#FFE66D",
    "struct": "#FFE66D",
    "typeParameter": "#FFE66D",
    "parameter": "#00E8C6",
    "variable": "#00E8C6",
    "property": "#00E8C6",
    "enumMember": "#F39C12",
    "event": "#FFE66D",
    "function": "#FFE66D",
    "method": "#FFE66D",
    "macro": "#C74DED",
    "keyword": "#C74DED",
    "modifier": "#C74DED",
    "comment": "#A0A1A7CC",
    "string": "#96E072",
    "number": "#F39C12",
    "regexp": "#FC644D",
    "operator": "#EE5D43"
  }
}
