    "focusBorder": "#C678DD",
    "widget.shadow": "#282C34",
    "selection.background": "#3E4451",
    "icon.foreground": "#5C6370",

    "window.activeBorder": "#282C34",
    "window.inactiveBorder": "#282C34",

    "editor.background": "#282C34",
    "editor.foreground": "#ABB2BF",
    "editorLineNumber.foreground": "#5C6370",
    "editorLineNumber.activeForeground": "#C678DD",
    "editorCursor.foreground": "#ABB2BF",
